    "IsGet_Obj_Motorcycle": {
        "Readable": "Motorcycle Unlocked",
        "Description": "Toggle Master-Cycle Zero ownership, independent of unlock requirements."
    },
    "IsGet_Obj_Porch_Weapon": {
        "Readable": "Weapon Obtained",
        "Description": "Determines whether a weapon has ever been picked up before."
    },
    "IsGet_Obj_Porch_Bow": {
        "Readable": "Bow Obtained",
        "Description": "Determines whether a bow has ever been picked up before."
    },

    /**
    * s32_data
    */
    "CurrentRupee": {
        "Readable": "Rupees",
        "Description": "The current rupee balance in your inventory."
    },
    "CurrentMamo": {
        "Readable": "Mon",
        "Description": "The current Mon balance for use at Koltin's shop."
    },
    "MaxHartValue": {
        "Readable": "Max Hearts",
        "Editor": "Hearts",
        "Description": "Link's current maximum hearts.",
        "DevNote": "Health is an integer value which ranges from 12 (1 heart) to 120 (30 hearts), with each Heart Container worth 4 units.\n\nThe spinner adjusts health by 4 per step. The game caps your maximum health to 30 hearts, and prevents you from having less than 3. You cannot go above 30 hearts, but you can go below 3!\n\nSetting this to zero makes you die every time you load this file."
    },
    // "KorokNutsNum": {
    //     "Readable": "Korok Seeds",
    //     "Description": "The number of collected Korok Seeds."
    // },
    "HiddenKorok_Number": {
        "Readable": "Korok Seeds",
        "Description": "The number of collected Korok Seeds."
    },
    "DefeatedSandwormNum": {
        "Readable": "Moldugas Defeated",
        "Description": "The number of unique Moldugas defeated."
    },
    "DefeatedForestGiantNum": {
        "Readable": "Hinoxes Defeated",
        "Description": "The number of unique Hinoxes defeated."
    },
    "DefeatedGolemNum": {
        "Readable": "Taluses Defeated",
        "Description": "The number of unique Taluses defeated"
    },
    "PlayReport_PlayTime": {
        "Readable": "Total Playtime",
        "Description": "The amount of time played (in seconds)",
        "Unit": "seconds"
    },
    "WeaponPorchStockNum": {
        "Readable": "Weapon Slots",
        "Description": "The number of available slots in the weapon inventory."
    },
    "ShieldPorchStockNum": {
        "Readable": "Shield Slots",
        "Description": "The number of available slots in the shield inventory."
    },
    "BowPorchStockNum": {
        "Readable": "Bow Slots",
        "Description": "The number of available slots in the bow inventory."
    },

    /**
    * f32_data
    */
    "dummy_float": {
        "Readable": "Dummy Value",
        "Description": "This value does nothing. It has a minimum value of 0, and a maximum value of 255."
    },
    "StaminaMax": {
        "Readable": "Max Stamina",
        "Editor": "Stamina",
        "Description": "Link's current maximum stamina.",
        "DevNote": "Stamina is a float value which ranges from 1000 (1 wheel) to 3000 (3 wheels), with each Stamina Vessel worth 200 units.\n\nThe spinner adjusts stamina by 200 per step. Normally, you can only obtain up to 10 upgrades, but the spinner supports up to 327 (65,535 units), allowing stamina to exceed the visual maximum!\n\nSetting this to zero - alike hearts - doesn't corrupt your save... but it does cause some weirdness."

        // "MaxValue": 3000
    },
    "MiniGame_BirdMan_HillTower_RecordDistance": {
        "Readable": "Paragliding Minigame Record",
        "Description": "Your record distance travelled in the 'Bird Man Research' paragliding minigame. Why do you even need to edit this?",
        "Unit": "metres"
    },
    "Motorcycle_Energy" : {
        "Readable" : "Motorcycle Energy",
        "Description" : "The remaining fuel in the Master Cycle Zero. Maximum energy is 1,000 units."
    },

    /**
    * string_data
    */
    "ActorName_SeakSensor_Slot0": {
        "Readable": "Shiekah Sensor Target",
        "Editor": "ActorName",
        "Description": "The currently targeted Sheikah Sensor actor name."
    },

    /**
    * vector3f_data
    */
    "PlayerSavePos":{
        "Readable": "Link Position",
        "Description": "Link's current position in Hyrule."
    },
    "WarpDLC_DestPos": {
        "Readable": "Travel Medallion Position",
        "Description": "The position of the travel medallion if placed."
    },
    "Horse_Pos": {
        "Readable": "Horse Position",
        "Description": "The current position of the active horse."
    },
    "ShootingStarPosition": {
        "Readable": "Star Fragment Position",
        "Description": "The position of the current active Star Fragment. Setting this when there is no current Star Fragment will spawn one at that position when the file is loaded."
    },

    /**
    * other
    */
    "PlayerName": {
        "Readable": "Player Name",
        "Description": "'PlayerName', a seemingly unused value, likely originally designed - like older Zelda games - for the player to choose their own name. Interesting!"
    },
    "PorchItem": {
        "Readable": "PorchItem",
        "Description": "Inventory items stored as an array of actor names.",
        "Editor": "Tile" // For inventory-type menus. Tells the Widget builder to make a square slot.
    }
